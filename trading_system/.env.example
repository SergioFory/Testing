# ============================================================
# TRADING SYSTEM — Variables de entorno
# Copia este archivo como .env y completa los valores
# NUNCA subas .env a GitHub
# ============================================================

# Binance API (solo lectura recomendado para datos)
BINANCE_API_KEY=tu_api_key_aqui
BINANCE_API_SECRET=tu_api_secret_aqui

# CryptoPanic API (gratis en https://cryptopanic.com/developers/api/)
CRYPTOPANIC_API_KEY=tu_key_aqui

# Anthropic Claude API (opcional — para análisis de noticias con IA)
ANTHROPIC_API_KEY=tu_key_aqui

# Telegram (opcional — para notificaciones de señales)
TELEGRAM_BOT_TOKEN=tu_bot_token
TELEGRAM_CHAT_ID=tu_chat_id
