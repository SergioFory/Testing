# ============================================================
# TRADING SYSTEM — Variables de entorno
# Copia este archivo como .env y completa los valores que necesites
# NUNCA subas .env a GitHub
#
# Nota: Para descargar datos públicos (OHLCV, funding rates) NO
# necesitas API keys. Solo se requieren para operar en real o
# leer Open Interest histórico.
# ============================================================

# Binance API (opcional — solo para Open Interest y trading real)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# CryptoPanic API (opcional — análisis de noticias)
# Regístrate gratis en https://cryptopanic.com/developers/api/
CRYPTOPANIC_API_KEY=

# Anthropic Claude API (opcional — análisis de noticias con IA)
ANTHROPIC_API_KEY=

# Telegram (opcional — notificaciones de señales)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
