# ============================================================
# TRADING SYSTEM — Variables de entorno
# Copia este archivo como .env y completa los valores que necesites
# NUNCA subas .env a GitHub
#
# Nota: Para descargar datos públicos (OHLCV, funding rates) NO
# necesitas API keys. Solo se requieren para operar en real o
# leer Open Interest histórico.
# ============================================================

# Binance API (opcional — solo para Open Interest y trading real)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# CryptoPanic API — DISCONTINUADO (plan gratuito eliminado el 01-Apr-2026)
# El sentimiento ahora usa el Fear & Greed Index (Alternative.me) — sin API key.
# CRYPTOPANIC_API_KEY=   ← ya no es necesaria

# Anthropic Claude API (opcional — análisis de noticias con IA)
ANTHROPIC_API_KEY=

# Telegram (opcional — notificaciones de señales)
# 1. Crea un bot con @BotFather en Telegram → /newbot → copia el token
# 2. Habla al bot o añádelo a un grupo, luego obtén el chat_id con:
#    curl https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ============================================================
# PRODUCCIÓN (Render.com) — Render inyecta DATABASE_URL automáticamente
# al conectar una base de datos PostgreSQL al servicio.
# En desarrollo local NO necesitas esta variable (usa SQLite).
# ============================================================
DATABASE_URL=
